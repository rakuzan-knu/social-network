{
  "name": "social-network",
  "private": true,
  "license": "AGPL-3.0",
  "type": "module",
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "dev:backend": "npm run start:dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "lint": "npm run lint -w backend && npm run lint -w frontend",
    "lint:fix": "npm run lint:fix -w backend && npm run lint:fix -w frontend",
    "test": "npm run test -w backend && npm run test -w frontend",
    "test:cov": "npm run test:cov -w backend && npm run test:cov -w frontend",
    "test:e2e": "npm run test:e2e -w backend",
    "format": "npm run format -w backend && npm run format -w frontend",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "prepare": "node -e \"process.env.CI || require('child_process').execSync('husky', { stdio: 'inherit' })\"",
    "docker:dev:up": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:dev:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "docker:dev:build": "docker compose -f docker-compose.dev.yml build",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml logs -f",
    "docker:prod:build": "docker compose -f docker-compose.prod.yml build",
    "docker:clean": "docker compose -f docker-compose.dev.yml down -v --remove-orphans && docker compose -f docker-compose.prod.yml down -v --remove-orphans",
    "docker:prune": "docker system prune -f && docker volume prune -f",
    "lhci": "lhci autorun",
    "validate:eol": "node scripts/validate-eol.js",
    "validate:env": "node scripts/check-env.js",
    "clean": "node scripts/clean.js",
    "clean:prune": "node scripts/clean.js --prune",
    "format:check": "prettier --check . --ignore-unknown --no-error-on-unmatched-pattern",
    "validate": "npm run validate:eol && npm run validate:env && npm run typecheck && npm run lint"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@lhci/cli": "^0.15.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "concurrently": "^9.1.2",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "enhanced-resolve": "5.24.5",
    "eslint": "9.39.5",
    "husky": "^9.1.7",
    "jsesc": "3.1.0",
    "json-stable-stringify-without-jsonify": "1.0.1",
    "lint-staged": "^16.1.2",
    "node-releases": "2.0.53",
    "prettier": "^3.5.3",
    "semantic-release": "^24.2.3",
    "signal-exit": "4.1.0",
    "tapable": "2.3.3",
    "zod-validation-error": "5.0.0"
  },
  "overrides": {
    "vite": "^6.0.0",
    "multer": "^2.2.0",
    "uuid": "^11.1.1",
    "js-yaml": "^4.3.1",
    "postcss": "^8.5.18",
    "react-router": "^7.18.2",
    "socket.io-parser": "^4.2.7",
    "nanoid": "^3.3.17",
    "lucide-react": "1.29.0",
    "@storybook/react-vite": {
      "vite": "^6.0.0"
    }
  },
  "allowScripts": {
    "esbuild": true,
    "prisma": true,
    "@prisma/client": true,
    "@prisma/engines": true,
    "argon2": true,
    "msw": true,
    "msgpackr-extract": true,
    "unrs-resolver": true,
    "@scarf/scarf": false
  },
  "lint-staged": {
    "backend/src/**/*.ts": [
      "npx eslint --config backend/eslint.config.mjs --fix",
      "npx prettier --write"
    ],
    "frontend/src/**/*.{ts,tsx}": [
      "npx eslint --config frontend/eslint.config.js --fix",
      "npx prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=10.0.0"
  }
}
