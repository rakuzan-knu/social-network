#!/bin/sh
set -e

BOLD="\033[1m"
GREEN="\033[0;32m"
YELLOW="\033[0;33m"
RED="\033[0;31m"
BLUE="\033[0;36m"
GRAY="\033[0;90m"
NC="\033[0m"

log_info()    { echo "${BLUE}ℹ${NC} $1"; }
log_success() { echo "${GREEN}✔${NC} $1"; }
log_warn()    { echo "${YELLOW}⚠${NC} $1"; }
log_error()   { echo "${RED}✖ $1${NC}"; }

log_info "Validating line endings..."
node scripts/validate-eol.js >/dev/null 2>&1 || {
  log_error "Line endings validation failed!"
  node scripts/validate-eol.js
  exit 1
}
log_success "Line endings valid"

if git diff --cached --name-only | grep -qE '(^|/)package\.json$'; then
  log_info "Checking package.json & lockfile sync..."

  if ! git diff --cached --name-only | grep -qE '(^|/)package-lock\.json$'; then
    log_error "package.json is staged, but package-lock.json is NOT staged!"
    echo "  ${GRAY}Run 'npm install' and stage package-lock.json via 'git add package-lock.json'${NC}"
    exit 1
  fi

  npm install --package-lock-only --ignore-scripts --no-audit >/dev/null 2>&1

  if ! git diff --exit-code package-lock.json >/dev/null 2>&1; then
    log_error "package-lock.json is out of sync with package.json"
    echo "  ${GRAY}Run 'npm install' to fix lockfile and stage the updated package-lock.json${NC}"
    exit 1
  fi
  log_success "Lockfile is synced"
fi

if command -v graphify >/dev/null 2>&1; then
  if git diff --cached --name-only | grep -qE '\.(js|jsx|ts|tsx)$'; then
    log_info "Updating code graph (Graphify)..."
    
    graphify . --code-only >/dev/null 2>&1 || true
    graphify cluster-only . >/dev/null 2>&1 || true
    git add graphify-out/GRAPH_REPORT.md 2>/dev/null || true
    
    log_success "Code graph updated"
  fi
fi

log_info "Running lint-staged..."
if [ -f "./node_modules/.bin/lint-staged" ]; then
  ./node_modules/.bin/lint-staged --concurrent false
else
  npx --no-install lint-staged --concurrent false
fi

echo "${GREEN}${BOLD}✔ All pre-commit checks passed successfully!${NC}\n"