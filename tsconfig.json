{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["*.js", "*.cjs", "*.mjs", "*.ts", "scripts/**/*"],
  "references": [{ "path": "./backend" }, { "path": "./frontend" }]
}
