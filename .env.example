POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=postgresdb
DATABASE_URL=postgresql://user:password@localhost:5432/social_network?schema=public
DIRECT_URL=postgresql://user:password@localhost:5432/social_network?schema=public
DATABASE_POOL_LIMIT=20
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_QUERY_TIMEOUT_MS=10000

REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_secure_password_here
REDIS_MAXMEMORY_POLICY=allkeys-lru

JWT_ACCESS_SECRET=your_jwt_secret_here
JWT_ACCESS_TTL=date
JWT_REFRESH_SECRET=your_jwt_secret_here
JWT_REFRESH_TTL=date

MINIO_ROOT_USER=minio_user
MINIO_ROOT_PASSWORD=minio_password

DOCKER_REGISTRY=your_docker

GF_SECURITY_ADMIN_USER=admin_name
GF_SECURITY_ADMIN_PASSWORD=grafana_admin_password
BACKUP_RETENTION_DAYS=7

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2