{
  "name": "@social-network/blinded-crypto",
  "version": "1.0.0",
  "description": "Portable blind-signature crypto v1 (RSA modpow): windowed modular exponentiation, blind sign/verify over hex. Pure BigInt, zero dependencies, no Node APIs.",
  "license": "AGPL-3.0-only",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test tests/blinded.test.cjs",
    "bench": "npm run build && node benches/blinded.bench.cjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
