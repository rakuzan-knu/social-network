# Database
DATABASE_URL=postgresql://user:password@localhost:5432/social?schema=public
DIRECT_URL=postgresql://user:password@localhost:5432/social?schema=public
DATABASE_POOL_LIMIT=20
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_QUERY_TIMEOUT_MS=10000

# Redis
REDIS_URL=redis://localhost:6379
REDIS_MAXMEMORY_POLICY=noeviction

# JWT
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=

# App
PORT=
CORS_ORIGIN=

# AWS (optional for local dev)
AWS_BUCKET_NAME=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=

# Minio
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_PUBLIC_URL=

# Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=

# Blind-signature room keys (hex). Optional: when absent, the server generates
# an ephemeral 2048-bit demo keypair per process (rooms do NOT survive restarts).
# Production: inject from HSM/secret manager, never commit real values.
BLIND_RSA_N_HEX= # optional
BLIND_RSA_E_HEX= # optional
BLIND_RSA_D_HEX= # optional

# Recommendation scoring preset: legacy (default) or balanced (recency+affinity A/B).
FEED_PRESET= # optional
# HTML sanitizer backend: legacy = sanitize-html (default, audited), pipeline = portable core (dark-launch).
SANITIZE_BACKEND= # optional

