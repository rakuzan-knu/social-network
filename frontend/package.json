{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --force",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ignore-pattern \"storybook-static\" --cache --cache-location .eslintcache",
    "lint:fix": "eslint . --ignore-pattern \"storybook-static\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:cov": "vitest run --config vitest.config.ts --coverage",
    "test:ui": "vitest --config vitest.config.ts --ui",
    "typecheck": "tsc --noEmit",
    "check:bundle": "node ../scripts/check-bundle-size.js",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@sentry/react": "10.70.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.18.1",
    "emoji-picker-react": "^4.19.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-router": "^8.3.0",
    "react-router-dom": "^7.18.1",
    "react-virtuoso": "4.18.11",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.3.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-essentials": "^8.6.0",
    "@storybook/addon-interactions": "^8.6.0",
    "@storybook/react": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@storybook/test": "^8.6.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "4.3.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "browser-assert": "^1.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "glob": "^13.0.6",
    "globals": "^17.6.0",
    "jsdoc-type-pratt-parser": "^9.1.1",
    "jsdom": "^30.0.1",
    "lru-cache": "^11.5.2",
    "memoizerific": "^1.11.3",
    "minipass": "^7.1.2",
    "msw": "^2.14.6",
    "path-scurry": "^2.0.2",
    "prettier": "^3.5.3",
    "process": "^0.11.10",
    "recast": "^0.24.0",
    "storybook": "^10.5.7",
    "strip-literal": "4.0.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.61.0",
    "unplugin": "^3.3.0",
    "util": "^0.12.5",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "vite": "$vite",
    "uuid": "^11.1.1"
  }
}
